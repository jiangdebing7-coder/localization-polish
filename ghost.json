{
  "schemaVersion": 3,
  "minCindyVersion": "0.1.91",
  "id": "localization-polish",
  "name": "本地化润色",
  "description": "按内容定制润色，名称默认锁定拼写与大小写；四列人工验收、简短修改原因及修改标黄。",
  "whenToUse": "润色或审校游戏、应用、产品及 UI 的现有译文，消除翻译腔、核对原意、术语和格式；支持任意语言组合、地区变体，以及需要原文、译文、优化后译文、逐条修改原因的人工验收表和 Excel/CSV 交付场景。",
  "version": "1.4.0",
  "kind": "chip",
  "entry": "main.js",
  "command": "本地化润色",
  "tools": [
    {
      "name": "prepare_polish_task",
      "description": "根据当前 Agent 对本批内容的语义分析，组装本次专属润色提示并返回 task_prompt。调用前先理解用户文本，简要归纳用途、语气与限制；不要按关键词机械分类，不要重复传整份原文或译文。工具不自行调用模型或生成译文，不联网、不写文件、不保存任务状态。返回提示供当前模型执行，完整流程见 localization-polish 手册。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target_language": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "目标语言及已知地区；地区未指定时如实说明，不猜测。"
          },
          "context": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600,
            "description": "本批用途、受众、产品或角色背景的简短归纳；仅用已知信息。"
          },
          "has_source": {
            "type": "boolean",
            "description": "是否有可对照原文；混合批次按原文可用情况分组处理。"
          },
          "segments": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "scope": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "description": "适用段落、条目或 ID 范围；同用途归组，不粘贴全部文本。"
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400,
                  "description": "本组文案希望玩家感受到或执行的事情，根据真实输入判断。"
                },
                "direction": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000,
                  "description": "区分名称与描述；名称保留项目拼写、大小写，其他内容按本组意图制定表达策略。不能为统一风格自行改名。"
                }
              },
              "required": [
                "scope",
                "purpose",
                "direction"
              ]
            },
            "description": "按真实用途分组，自由制定各组策略；短句只需一组，不逐行生成提示。"
          },
          "requirements": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400,
              "description": "用户明确要求、术语及大小写规范；不能从同组多数写法推断名称规范。"
            }
          },
          "unknowns": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400,
              "description": "尚未确定且影响改写的事项，不把推测写成事实。"
            }
          }
        },
        "required": [
          "target_language",
          "context",
          "has_source",
          "segments"
        ]
      }
    },
    {
      "name": "export_review_xlsx",
      "description": "生成四列验收 Excel，在当前会话工作目录新建 .xlsx，不覆盖输入、不联网、不执行命令。逐行区分名称 name 与文案 text；名称默认锁定完整拼写和大小写，修改时必须有项目确认目标 approved_name 及真实依据 name_basis，不能为“统一风格”自行填写。缺依据或与确认目标不符就拒绝导出。原因只简述改动；未改写“无需修改”，已改的 C 列标黄。成功后回读文件核对输入。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expected_rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "从本批原始输入核实的内容行数，含未修改条目；不得根据遗漏后的结果反填。"
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 32767,
                  "description": "从输入复制的完整原文，不能改写；确实未提供时为 null。"
                },
                "translation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32767,
                  "description": "从输入复制的完整修改前译文，不得用优化结果覆盖。"
                },
                "optimized_translation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32767,
                  "description": "完整优化后译文，未修改时逐字复制 translation。"
                },
                "changes": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32767
                  },
                  "description": "本行简短改动说明，例如“修正操作先后顺序，避免误导用户”；多处改动可用一两句合并说明。不要复制修改前后译文，不传 before/after。未改时传 []。"
                },
                "id": {
                  "type": "string",
                  "maxLength": 32767,
                  "description": "可选原始 ID，原样保留为第五列。"
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32767,
                  "description": "可选待确认事项，不得代替已修改行的 changes。"
                },
                "entry_type": {
                  "type": "string",
                  "enum": [
                    "name",
                    "text"
                  ],
                  "description": "必填。道具、装备、角色、技能等名称为 name；描述、对白、规则、提示为 text。名称与描述混合时保留内嵌专名，不以 text 绕过名称保护。"
                },
                "approved_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32767,
                  "description": "仅从用户确认的译名、术语表，或明确大小写/改名规则得到的完整目标名称。不得仅因自然度或同系列多数写法自行生成。无此依据时省略并保留原译。"
                },
                "name_basis": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32767,
                  "description": "与 approved_name 配对，说明该目标来自哪条用户要求或术语记录；不能将模型推测当成用户确认。"
                }
              },
              "required": [
                "entry_type",
                "source",
                "translation",
                "optimized_translation",
                "changes"
              ]
            },
            "description": "按原顺序排列，每条输入一条记录，包括名称、标题、未修改项和重复项。"
          }
        },
        "required": [
          "expected_rows",
          "rows"
        ]
      }
    },
    {
      "name": "check_protected_tokens",
      "description": "可选的固定片段核验工具，不生成或润色文本。润色请求由当前 Cindy Agent 直接完成并交付，不需要调用此工具；不得因缺少专用润色函数而拒绝。仅在需要逐字检查变量、资源键等固定片段时调用。本工具只统计调用者指定片段的出现次数，不解析模板语法、标签嵌套、参数顺序，也不判断翻译准确性。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "maxLength": 100000,
            "description": "原文，保持原样。"
          },
          "translation": {
            "type": "string",
            "maxLength": 100000,
            "description": "润色后的目标文本，保持原样。"
          },
          "tokens": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "description": "需要逐字保留的变量、资源键、URL 等完整片段；不要加入应被翻译或本地化的内容。"
          }
        },
        "required": [
          "source",
          "translation",
          "tokens"
        ]
      }
    }
  ],
  "manual": {
    "items": [
      {
        "dir": "manual/localization-polish",
        "name": "localization-polish",
        "description": "按批次定制润色策略、分场景改写，以及四列人工验收交付流程。"
      }
    ]
  }
}
