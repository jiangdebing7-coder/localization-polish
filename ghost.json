{
  "schemaVersion": 3,
  "minCindyVersion": "0.1.91",
  "id": "localization-polish",
  "name": "本地化润色",
  "description": "多语种译文润色与逐条人工验收。专用工具固定生成四列 Excel，缺少修改明细拒绝导出；未改填“无需修改”，已修改译文标黄。",
  "whenToUse": "润色或审校游戏、应用、产品及 UI 的现有译文，消除翻译腔、核对原意、术语和格式；支持任意语言组合、地区变体，以及需要原文、译文、优化后译文、逐条修改原因的人工验收表和 Excel/CSV 交付场景。",
  "version": "1.1.0",
  "kind": "chip",
  "entry": "main.js",
  "command": "本地化润色",
  "tools": [
    {
      "name": "export_review_xlsx",
      "description": "润色完成后生成供人工验收的 Excel 文件。先读取 localization-polish 手册并从输入保留原文和原译，再提交每行完整优化结果及逐项改前/改后/原因。本工具在当前会话工作目录新建唯一命名的 .xlsx，不修改输入文件、不联网、不执行命令。固定输出原文、译文、优化后译文、修改原因四列；未改自动写“无需修改”，修改后的 C 列标黄。缺数据、缺原因或修改点无法重建最终译文时拒绝导出并指出行号。成功后回读实际文件再交付，不另写两列或三列替代品。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expected_rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "从本批原始输入核实的内容行数，含未修改条目；不得根据遗漏后的结果反填。"
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "source": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 32767,
                  "description": "从输入复制的完整原文，不能改写；确实未提供时为 null。"
                },
                "translation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32767,
                  "description": "从输入复制的完整修改前译文，不得用优化结果覆盖。"
                },
                "optimized_translation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32767,
                  "description": "完整优化后译文，未修改时逐字复制 translation。"
                },
                "changes": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "before": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 32767,
                        "description": "本次替换前的准确措辞，必须在当前译文中唯一出现；重复时扩大上下文或引用整句。"
                      },
                      "after": {
                        "type": "string",
                        "maxLength": 32767,
                        "description": "替换后的准确措辞，删除时可为空。"
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 32767,
                        "description": "解释此项具体改动及依据，不能只写“更自然”“已优化”。"
                      }
                    },
                    "required": [
                      "before",
                      "after",
                      "reason"
                    ]
                  },
                  "description": "按顺序应用的具体修改点，必须能完整重建 optimized_translation；未改时传 []，工具自动填写“无需修改”。"
                },
                "id": {
                  "type": "string",
                  "maxLength": 32767,
                  "description": "可选原始 ID，原样保留为第五列。"
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32767,
                  "description": "可选待确认事项，不得代替已修改行的 changes。"
                }
              },
              "required": [
                "source",
                "translation",
                "optimized_translation",
                "changes"
              ]
            },
            "description": "按原顺序排列，每条输入一条记录，包括名称、标题、未修改项和重复项。"
          }
        },
        "required": [
          "expected_rows",
          "rows"
        ]
      }
    },
    {
      "name": "check_protected_tokens",
      "description": "可选的固定片段核验工具，不生成或润色文本。润色请求由当前 Cindy Agent 直接完成并交付，不需要调用此工具；不得因缺少专用润色函数而拒绝。仅在需要逐字检查变量、资源键等固定片段时调用。本工具只统计调用者指定片段的出现次数，不解析模板语法、标签嵌套、参数顺序，也不判断翻译准确性。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "maxLength": 100000,
            "description": "原文，保持原样。"
          },
          "translation": {
            "type": "string",
            "maxLength": 100000,
            "description": "润色后的目标文本，保持原样。"
          },
          "tokens": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "description": "需要逐字保留的变量、资源键、URL 等完整片段；不要加入应被翻译或本地化的内容。"
          }
        },
        "required": [
          "source",
          "translation",
          "tokens"
        ]
      }
    }
  ],
  "manual": {
    "items": [
      {
        "dir": "manual/localization-polish",
        "name": "localization-polish",
        "description": "多语种本地化润色方法、格式保护规则与默认四列人工验收输出规范。"
      }
    ]
  }
}
